# Long-cache immutable static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/hero-images/*
  Cache-Control: public, max-age=31536000, immutable

/brand-logos/*
  Cache-Control: public, max-age=31536000, immutable

/branding/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/products/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — short cache so deploys propagate quickly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
